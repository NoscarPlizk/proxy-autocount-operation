# Local backend server settings
HOST=127.0.0.1
PORT=3001

# Company One: keep the account-book identifier inside the company root URL.
AUTOCOUNT_COMPANY_ONE_ROOT_URL=https://accounting-api.autocountcloud.com/<company-one-account-book-id>
AUTOCOUNT_COMPANY_ONE_KEY_ID=<company-one-key-id>
AUTOCOUNT_COMPANY_ONE_API_KEY=<company-one-api-key>

# Company Two: separate credentials even if it shares an AutoCount registered account.
AUTOCOUNT_COMPANY_TWO_ROOT_URL=https://accounting-api.autocountcloud.com/<company-two-account-book-id>
AUTOCOUNT_COMPANY_TWO_KEY_ID=<company-two-key-id>
AUTOCOUNT_COMPANY_TWO_API_KEY=<company-two-api-key>

# Company Three: standalone account, using the same three-value configuration shape.
AUTOCOUNT_COMPANY_THREE_ROOT_URL=https://accounting-api.autocountcloud.com/<company-three-account-book-id>
AUTOCOUNT_COMPANY_THREE_KEY_ID=<company-three-key-id>
AUTOCOUNT_COMPANY_THREE_API_KEY=<company-three-api-key>
